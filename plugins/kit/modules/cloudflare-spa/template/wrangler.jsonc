{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The SPA, served as static assets at {{domain}}. Zone routes of other Workers on this domain run first.
  "name": "{{name}}-web",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "{{domain}}", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
